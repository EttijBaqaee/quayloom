# Local default. Remote binding requires an exact PUBLIC_ORIGIN (no trailing slash).
HOST=127.0.0.1
PORT=9810
# PUBLIC_ORIGIN=https://chat.example.com
COOKIE_SECURE=false
# Initial password only, 12–1024 chars. Omit for a one-time generated password.
# ADMIN_PASSWORD_FILE=/run/secrets/quayloom-admin-password
# ADMIN_PASSWORD=
DATA_DIR=./data
QUOTA_TIME_ZONE=Asia/Shanghai
# Runtime path; unset/empty defaults to /quayloom. No image rebuild is needed.
# Case and nested paths are preserved (for example /Quayloom or /nested/app).
# The reverse proxy must preserve and match this exact path.
BASE_PATH=/quayloom
# Optional: Base64 encoding of exactly 32 random bytes. Never change after initialization.
# If omitted, data/master.key is generated and MUST be backed up with the database.
# STUDIO_MASTER_KEY=
