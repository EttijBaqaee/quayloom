<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.quayloom.android" android:versionCode="4" android:versionName="0.2.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Quayloom" android:icon="@drawable/quayloom" android:theme="@style/AppTheme"
        android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="true"
        android:supportsRtl="true" android:enableOnBackInvokedCallback="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
