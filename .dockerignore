# Keep the build context free of local dependencies, generated output and runtime data.
.git
.github
STUDIO-CONTRACT.md
node_modules
.pnpm-store
.npm
.cache
dist
dist-source
build
data
.test-data
tmp
temp
.temp
artifacts
backups
secrets
credentials
logs
.env
.env.*
!.env.example
.pnpmrc
.netrc
.ssh
.vscode
.idea

# Internal checks/evidence are not part of the public application image.
**/*.test.*
**/*.spec.*
**/test
**/tests
**/__tests__
**/__snapshots__
**/fixtures
coverage
test-results
playwright-report
screenshots
verification
evidence
report
reports
deployment
deployments
production
/docs/*
!/docs/ACCESS_CODES.md
!/docs/DEPLOYMENT.md
/scripts/*
!/scripts/build.mjs
!/scripts/package-source.mjs

